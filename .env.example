# Database Connection (Supabase PostgreSQL via Supavisor Pooler Port 6543)
# Contoh: postgres://postgres.xxxxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DATABASE_URL="YOUR_SUPABASE_SUPAVISOR_CONNECTION_STRING"

# Upstash Redis (For Real-Time Master Timer Offset)
REDIS_URL="https://your-redis-instance.upstash.io"
REDIS_TOKEN="your_redis_token"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="gunakan_string_acak_dan_panjang_di_sini"
